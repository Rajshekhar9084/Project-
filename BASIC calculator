#include <stdio.h>
#include <math.h>  // for pow function

void print_menu();  // Function prototype

int main() {
    int First, Second, Result;
    int choice;

    while (1) {
        print_menu();

        printf("\nEnter your choice (1-7): ");
        scanf("%d", &choice);

        if (choice == 7) {
            printf("Exiting calculator. Goodbye!\n");
            break;
        }

        printf("Enter First number: ");
        scanf("%d", &First);
        printf("Enter Second number: ");
        scanf("%d", &Second);

        switch (choice) {
            case 1: // Addition
                Result = First + Second;
                printf("Result = %d\n", Result);
                break;
            case 2: // Subtraction
                Result = First - Second;
                printf("Result = %d\n", Result);
                break;
            case 3: // Multiplication
                Result = First * Second;
                printf("Result = %d\n", Result);
                break;
            case 4: // Division
                if (Second != 0) {
                    Result = First / Second;
                    printf("Result = %d\n", Result);
                } else {
                    printf("Error: Division by zero!\n");
                }
                break;
            case 5: // Modulo
                if (Second != 0) {
                    Result = First % Second;
                    printf("Result = %d\n", Result);
                } else {
                    printf("Error: Division by zero!\n");
                }
                break;
            case 6: // Power
                Result = pow(First, Second);
                printf("Result = %d\n", Result);
                break;
            default:
                printf("Invalid choice. Please enter a number between 1 and 7.\n");
        }
    }

    return 0;
}

void print_menu() {
    printf("\n=== Welcome to the Basic Calculator ===\n");
    printf("Choose one of the following operations:\n");
    printf("1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");
    printf("5. Modulo\n");
    printf("6. Power\n");
    printf("7. Exit\n");
      }
